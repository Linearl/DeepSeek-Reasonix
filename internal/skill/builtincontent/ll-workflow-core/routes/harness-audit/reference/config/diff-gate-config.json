{
  "threshold": 500,
  "codeExtensions": [
    ".ts", ".tsx", ".js", ".jsx",
    ".py", ".go", ".rs", ".java",
    ".c", ".cpp", ".h"
  ],
  "excludePatterns": [
    "node_modules", "dist", ".git",
    "*.lock", "*.md", "*.json",
    "*.yaml", "*.yml"
  ],
  "capabilityGate": {
    "fuzzyMatch": true,
    "fuzzyMatchStyles": [
      "snake_case",
      "camelCase",
      "PascalCase"
    ]
  }
}
